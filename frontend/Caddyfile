carconnect.duckdns.org {
	# Backend API and uploaded images — proxied to the backend container.
	handle /api/* {
		reverse_proxy backend:5000
	}

	handle /uploads/* {
		reverse_proxy backend:5000
	}

	# Everything else: serve the built React app, falling back to
	# index.html for client-side (React Router) routes.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# Vero Italiano (separate project, ~/VeroItaliano on the same server) shares this Caddy.
# Its nginx container "vero-client" serves the site and proxies /api and /uploads itself.
# Keep this block here: the Caddyfile is baked into this image, so a block added only on
# the server is lost on every CarConnect deploy.
veroitaliano.duckdns.org {
	reverse_proxy vero-client:80
}

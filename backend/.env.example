PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (get from Atlas > Connect > Drivers).
# Include a database name in the path, e.g. .../carconnect?retryWrites=true...
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority&appName=<app-name>

# Random secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Restrict which origin can call this API. In production, set this to the
# deployed frontend's public URL. Leave unset for local dev (allows any
# origin, since Vite's dev server runs on a different port).
# CORS_ORIGIN=https://your-domain.duckdns.org
